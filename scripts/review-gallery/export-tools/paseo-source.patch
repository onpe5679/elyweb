+export function getEnrichedGamesByStudio(studioId?: 'elysian' | 'habom' | 'all'): EnrichedGame[] {
+  if (!studioId || studioId === 'all') return ENRICHED_GAMES;
+  return ENRICHED_GAMES.filter((g) => g.studioId === studioId);
+}
+
+export function getEnrichedGameBySlug(slug: string): EnrichedGame | undefined {
+  return ENRICHED_GAMES.find(
+    (g) => g.slug.toLowerCase() === slug.toLowerCase()
+  );
+}
+
+export function getEnrichedTeamMemberBySlug(slug: string): EnrichedTeamMember | undefined {
+  return ENRICHED_TEAM_MEMBERS.find(
+    (m) => m.slug.toLowerCase() === slug.toLowerCase()
+  );
+}
+
+export function loc(textObj: LocalizedText | undefined, locale: string): string {
+  if (!textObj) return '';
+  const key = (locale === 'en' || locale === 'ja' ? locale : 'ko') as LocaleKey;
+  return textObj[key] || textObj.ko;
+}
