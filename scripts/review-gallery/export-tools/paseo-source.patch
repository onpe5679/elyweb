@@ -0,0 +1,950 @@
+'use client';
+
+import { useState, useEffect } from 'react';
+import { Link } from '@/i18n/routing';
+import { StudioGame, STUDIO_GAMES, tText } from '@/lib/studio-data';
+import HabomDialogueExperience from '@/components/habom/HabomDialogueExperience';
+
+interface GameDetailClientProps {
+  game: StudioGame;
+  locale: string;
+}
+
+type DetailTab = 'overview' | 'media' | 'characters' | 'credits';
+
+export default function GameDetailClient({ game, locale }: GameDetailClientProps) {
+  const [activeTab, setActiveTab] = useState<DetailTab>('overview');
+  const [lightboxIndex, setLightboxIndex] = useState<number | null>(null);
+  const [activeVideoIndex, setActiveVideoIndex] = useState<number | null>(null);
+
+  const isHabom = game.studio === 'habom';
+  const otherGames = STUDIO_GAMES.filter((g) => g.slug !== game.slug);
+
+  useEffect(() => {
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (lightboxIndex !== null) {
+        if (e.key === 'Escape') {
+          setLightboxIndex(null);
+        } else if (e.key === 'ArrowRight') {
+          setLightboxIndex((prev) =>
+            prev !== null ? (prev + 1) % game.screenshots.length : null
+          );
+        } else if (e.key === 'ArrowLeft') {
+          setLightboxIndex((prev) =>
+            prev !== null
+              ? (prev - 1 + game.screenshots.length) % game.screenshots.length
+              : null
+          );
+        }
+      } else if (activeVideoIndex !== null && e.key === 'Escape') {
