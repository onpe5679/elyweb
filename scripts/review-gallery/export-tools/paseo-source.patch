+export const STUDIO_TEAM: StudioTeamMemberView[] = ENRICHED_TEAM_MEMBERS.map((m) => ({
+  slug: m.slug,
+  name: m.name,
+  handle: m.slug,
+  role: m.role,
+  bio: m.fullBioParagraphs[0] || m.shortBio,
+  highlights: m.creditsList,
+  participatedWorks:
+    m.slug === 'anhanuel'
+      ? ['sharehouse']
+      : ['memorial-circuit', 'IBAT', 'festival-not-over', 'cella', 'sharehouse'],
+}));
+
+export interface StudioTimelineView {
+  id: string;
+  year: string;
+  month: string;
+  category: string;
+  title: LocalizedText;
+  description: LocalizedText;
+}
+
+export const STUDIO_TIMELINE: StudioTimelineView[] = [...STUDIO_TIMELINE_EVENTS]
+  .reverse()
+  .map((ev, idx) => {
+    const [year, month] = ev.date.split('.');
+    return {
+      id: `tl-${idx + 1}`,
+      year: year || ev.date,
+      month: month || '01',
+      category: ev.category,
+      title: ev.title,
+      description: ev.title,
+    };
+  });
+
+export function getStudioGameBySlug(slug: string): StudioGame | undefined {
+  return STUDIO_GAMES.find((g) => g.slug.toLowerCase() === slug.toLowerCase());
+}
+
+export function getTeamMemberBySlugLocal(slug: string): StudioTeamMemberView | undefined {
+  return STUDIO_TEAM.find((m) => m.slug.toLowerCase() === slug.toLowerCase());
+}
